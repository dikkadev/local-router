[Unit]
Description=Local Router friendly .localhost reverse proxy for %i
After=network.target

[Service]
Type=simple
User=%i
StateDirectory=local-router-%i
ExecStart=/usr/local/bin/local-router serve --json --state-file /var/lib/local-router-%i/routes.jsonl --shield-imported
Restart=on-failure
RestartSec=2s

# Allow binding 127.0.0.1:80 without running the process as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# The router is a local loopback HTTP proxy/control plane.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
